# Only needed when the frontend is deployed separately from the backend.
# During local development, leave it unset: Vite forwards /api to the backend.
# Copy to frontend/.env.production and set your backend's public address, e.g.
# VITE_API_BASE_URL=https://vidnotes-api.onrender.com
#
# Never put API keys or secrets in frontend env files: everything here is
# bundled into public JavaScript. Supabase settings come from the backend.
VITE_API_BASE_URL=
